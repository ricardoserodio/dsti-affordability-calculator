"""
Validation tests for the actual sample scenarios CSV file.

These tests check that examples/sample_scenarios.csv exists, can be loaded and
contains the expected fictional scenario structure.

The project is educational, demonstrative and portfolio-oriented.
It must not be interpreted as a credit approval system, underwriting engine,
bank pricing model, financial advisory tool or replacement for formal human
credit analysis.
"""

import sys
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parents[1]
SRC_PATH = PROJECT_ROOT / "src"

if str(SRC_PATH) not in sys.path:
    sys.path.append(str(SRC_PATH))

from sample_scenario_loader import (
    REQUIRED_SAMPLE_SCENARIO_COLUMNS,
    load_and_validate_sample_scenarios,
)


def test_actual_sample_scenarios_csv_exists():
    sample_scenarios_path = PROJECT_ROOT / "examples" / "sample_scenarios.csv"

    assert sample_scenarios_path.exists()
    assert sample_scenarios_path.is_file()


def test_actual_sample_scenarios_csv_loads_successfully():
    sample_scenarios, validation_result = load_and_validate_sample_scenarios()

    assert validation_result.is_valid is True
    assert validation_result.missing_columns == []
    assert validation_result.row_count > 0
    assert len(sample_scenarios) == validation_result.row_count


def test_actual_sample_scenarios_csv_contains_required_columns():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    for column in REQUIRED_SAMPLE_SCENARIO_COLUMNS:
        assert column in sample_scenarios.columns


def test_actual_sample_scenarios_csv_contains_base_scenario():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    scenario_names = set(sample_scenarios["scenario_name"].tolist())

    assert "Base educational simulation" in scenario_names


def test_actual_sample_scenarios_csv_contains_euribor_fields():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert "euribor_tenor" in sample_scenarios.columns
    assert "simulated_euribor_percentage" in sample_scenarios.columns
    assert "simulated_spread_percentage" in sample_scenarios.columns
    assert "stress_buffer_percentage" in sample_scenarios.columns


def test_actual_sample_scenarios_csv_has_no_missing_scenario_names():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert sample_scenarios["scenario_name"].isna().sum() == 0
    assert (sample_scenarios["scenario_name"].astype(str).str.strip() != "").all()


def test_actual_sample_scenarios_csv_has_valid_euribor_tenors():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    allowed_tenors = {"1M", "3M", "6M", "12M"}
    actual_tenors = set(sample_scenarios["euribor_tenor"].astype(str).str.upper())

    assert actual_tenors.issubset(allowed_tenors)


def test_actual_sample_scenarios_csv_has_non_negative_spreads():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert (sample_scenarios["simulated_spread_percentage"] >= 0).all()


def test_actual_sample_scenarios_csv_has_non_negative_stress_buffers():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert (sample_scenarios["stress_buffer_percentage"] >= 0).all()


def test_actual_sample_scenarios_csv_has_positive_loan_amounts():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert (sample_scenarios["loan_amount"] > 0).all()


def test_actual_sample_scenarios_csv_has_positive_maturities():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert (sample_scenarios["loan_maturity_years"] > 0).all()


def test_actual_sample_scenarios_csv_has_scenario_notes():
    sample_scenarios, _ = load_and_validate_sample_scenarios()

    assert sample_scenarios["scenario_note"].isna().sum() == 0
    assert (sample_scenarios["scenario_note"].astype(str).str.strip() != "").all()
